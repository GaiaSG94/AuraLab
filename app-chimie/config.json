  ],
  "notebook": {
    "enabled": true,
    "prompts": [
      "Titrate 25 mL of HCl with the NaOH burette: where is the equivalence point on the pH curve?",
      "Mix CuSO4 with NaOH: what blue solid falls out, and how many grams?",
      "Add NH3 on top of that precipitate: why does it dissolve back into a deep blue solution?",
      "Mix NaHCO3 with HCl: watch the manometer climb. How much CO2 escapes?",
      "Titrate CH3COOH instead of HCl: why is the pH jump smaller at equivalence?",
      "Drop bromothymol blue in, then push the pH past 7.6: what color wins?",
      "Which mixture warms up the most: strong acid + strong base, or weak acid + strong base?"
    ]
  }
