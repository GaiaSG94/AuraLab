{
  "version": "v1",
  "hooks": [
    {
      "name": "law-registered",
      "description": "A new law file must be registered in its pack index, or it stays invisible.",
      "trigger": "PostFileSave",
      "matcher": "engines[\\\\/][^\\\\/]+[\\\\/]laws[\\\\/][^\\\\/]+\\.js$",
      "action": {
        "type": "command",
        "command": "node scripts/kiro-hook.mjs check-law"
      },
      "timeout": 30,
      "enabled": true
    },
    {
      "name": "no-dom-in-laws",
      "description": "Laws must stay DOM-free so they run in Node (REQ-15).",
      "trigger": "PostFileSave",
      "matcher": "engines[\\\\/][^\\\\/]+[\\\\/]laws[\\\\/][^\\\\/]+\\.js$",
      "action": {
        "type": "command",
        "command": "node scripts/kiro-hook.mjs check-law-dom"
      },
      "timeout": 30,
      "enabled": true
    }
  ]
}
