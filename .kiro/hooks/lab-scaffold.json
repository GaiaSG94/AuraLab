{
  "version": "v1",
  "hooks": [
    {
      "name": "lab-has-config",
      "description": "A new lab folder must ship a config.json, or it cannot boot.",
      "trigger": "FileCreate",
      "matcher": "app-[^\\\\/]+[\\\\/]index\\.html$",
      "action": {
        "type": "command",
        "command": "node scripts/kiro-hook.mjs check-new-lab"
      },
      "timeout": 30,
      "enabled": true
    }
  ]
}
